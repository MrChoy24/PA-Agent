/* =====================================================================
   PA Agent — "deep slate + teal" dark theme
   ---------------------------------------------------------------------
   Palette (mirrored from tokens.py, QSS has no variables):
     canvas      #0a0e14      raised    #161b22
     panel       #12171f      control   #1c2128 / #21262d
     border      #232b36      strong    #30363d / #3d444d
     text        #e6edf3 / #8b949e / #6e7681
     accent      #2dd4bf  hover #5eead4  pressed #14b8a6
     info        #38bdf8      ok #22c55e  warn #f59e0b  danger #ef4444

   Layout rhythm: 8px. Corner radii: 6 / 8 / 10 px.
   Note: translucent colours must use rgba(r,g,b,a) with a float alpha —
   Qt misreads 8-digit hex. No box-shadow / flex / calc / variables.
   ===================================================================== */

/* ---------------------------------------------------------------------
   1. Base
   --------------------------------------------------------------------- */

QWidget {
    color: #e6edf3;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
}

QMainWindow,
QDialog,
QMessageBox,
QPageSetupDialog,
QAbstractScrollArea#qt_scrollarea_viewport {
    background-color: #0a0e14;
}

QMainWindow::separator {
    background-color: #232b36;
    width: 1px;
    height: 1px;
}

QWidget:disabled {
    color: #4d565f;
}

QFrame[frameShape="4"] {  /* HLine */
    background-color: #232b36;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QFrame[frameShape="5"] {  /* VLine */
    background-color: #232b36;
    border: none;
    max-width: 1px;
    min-width: 1px;
}

/* ---------------------------------------------------------------------
   2. Typography helpers
   --------------------------------------------------------------------- */

QLabel#toolbarTitle {
    color: #e6edf3;
    font-size: 14px;
    font-weight: 600;
    padding: 0px;
}

QLabel#stageHeader {
    color: #5eead4;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 0px;
}

QLabel#mutedLabel {
    color: #8b949e;
    font-size: 12px;
}

QLabel#mutedLabel:disabled {
    color: #4d565f;
}

QLabel#livePriceLabel {
    color: #8b949e;
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", monospace;
    font-size: 13px;
    font-weight: 600;
    padding: 2px 10px 2px 16px;
    background: transparent;
    border: none;
}

QLabel#sectionLabel {
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
}

/* Status pills ------------------------------------------------------- */

QLabel#pillGreen,
QLabel#pillCyan,
QLabel#pillBlue,
QLabel#pillAmber,
QLabel#pillRed {
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#pillGreen {
    color: #86efac;
    background-color: rgba(34,197,94,0.10);
    border: 1px solid rgba(34,197,94,0.35);
}

QLabel#pillCyan {
    color: #5eead4;
    background-color: rgba(45,212,191,0.10);
    border: 1px solid rgba(45,212,191,0.35);
}

QLabel#pillBlue {
    color: #7dd3fc;
    background-color: rgba(56,189,248,0.10);
    border: 1px solid rgba(56,189,248,0.35);
}

QLabel#pillAmber {
    color: #fbbf24;
    background-color: rgba(245,158,11,0.10);
    border: 1px solid rgba(245,158,11,0.35);
}

QLabel#pillRed {
    color: #fca5a5;
    background-color: rgba(239,68,68,0.10);
    border: 1px solid rgba(239,68,68,0.35);
}

/* ---------------------------------------------------------------------
   3. Buttons
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 18px;
    min-width: 64px;
}

QPushButton:hover {
    background-color: #2b323a;
    border-color: #3d444d;
}

QPushButton:pressed {
    background-color: #1c2128;
    border-color: #2dd4bf;
}

QPushButton:focus {
    border-color: #2dd4bf;
    outline: none;
}

QPushButton:disabled {
    background-color: #161b22;
    color: #4d565f;
    border-color: #232b36;
}

/* Primary action — solid teal with dark ink for maximum contrast */
QPushButton#primaryButton {
    background-color: #2dd4bf;
    color: #04201c;
    border: 1px solid #2dd4bf;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #5eead4;
    border-color: #5eead4;
    color: #04201c;
}

QPushButton#primaryButton:pressed {
    background-color: #14b8a6;
    border-color: #14b8a6;
    color: #04201c;
}

QPushButton#primaryButton:disabled {
    background-color: #21262d;
    color: #4d565f;
    border-color: #232b36;
}

/* Destructive / stop action — tinted outline */
QPushButton#dangerButton {
    background-color: rgba(239,68,68,0.12);
    color: #fca5a5;
    border: 1px solid rgba(239,68,68,0.45);
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: rgba(239,68,68,0.20);
    border-color: #ef4444;
    color: #fecaca;
}

QPushButton#dangerButton:pressed {
    background-color: rgba(239,68,68,0.30);
    border-color: #ef4444;
    color: #fee2e2;
}

QPushButton#dangerButton:disabled {
    background-color: #161b22;
    color: #4d565f;
    border-color: #232b36;
}

/* Default dialog button (Save) picks up the accent automatically */
QPushButton:default {
    background-color: #2dd4bf;
    color: #04201c;
    border: 1px solid #2dd4bf;
    font-weight: 600;
}

QDialogButtonBox QPushButton {
    min-width: 84px;
    padding: 6px 18px;
}

/* Ghost icon/text button (collapse toggles, disclosure links) */
QToolButton {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}

QToolButton:hover {
    background-color: #21262d;
    color: #e6edf3;
    border-color: #30363d;
}

QToolButton:pressed {
    background-color: #1c2128;
    color: #e6edf3;
}

QToolButton:checked {
    color: #5eead4;
    background-color: rgba(45,212,191,0.10);
}

QToolButton:disabled {
    color: #4d565f;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    width: 8px;
    height: 8px;
}

QPushButton#decisionFlowFullscreenButton {
    background-color: transparent;
    color: #5eead4;
    border: 1px solid rgba(45,212,191,0.40);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    min-width: 0px;
    min-height: 0px;
}

QPushButton#decisionFlowFullscreenButton:hover {
    background-color: rgba(45,212,191,0.14);
    border-color: #2dd4bf;
    color: #99f6e4;
}

QPushButton#decisionFlowFullscreenButton:pressed {
    background-color: rgba(45,212,191,0.24);
}

/* ---------------------------------------------------------------------
   4. Text inputs
   --------------------------------------------------------------------- */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #0a0e14;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 18px;
    selection-background-color: rgba(45,212,191,0.30);
    selection-color: #e6edf3;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover {
    border-color: #3d444d;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border-color: #2dd4bf;
    background-color: #0d121a;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #12171f;
    color: #4d565f;
    border-color: #232b36;
}

QLineEdit[readOnly="true"] {
    background-color: #12171f;
    color: #8b949e;
}

QLineEdit#chatInput,
QPlainTextEdit#chatInput,
QTextEdit#chatInput {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: rgba(45,212,191,0.30);
    selection-color: #e6edf3;
}

QLineEdit#chatInput:hover,
QPlainTextEdit#chatInput:hover,
QTextEdit#chatInput:hover {
    border-color: #3d444d;
}

QLineEdit#chatInput:focus,
QPlainTextEdit#chatInput:focus,
QTextEdit#chatInput:focus {
    border-color: #2dd4bf;
    background-color: #21262d;
}

QPlainTextEdit,
QTextEdit {
    background-color: #12171f;
    color: #e6edf3;
    border: 1px solid #232b36;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: rgba(45,212,191,0.28);
    selection-color: #e6edf3;
}

QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #2dd4bf;
}

/* Reasoning output — recessed, monospaced, quiet */
QPlainTextEdit#reasoningPane,
QTextEdit#reasoningPane {
    background-color: #0a0e14;
    color: #8b949e;
    border: 1px solid #232b36;
    border-radius: 8px;
    padding: 10px 12px;
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}

/* Answer / conclusion text — the reading surface */
QTextEdit#answerPane,
QPlainTextEdit#answerPane {
    background-color: #12171f;
    color: #e6edf3;
    border: 1px solid #232b36;
    border-radius: 8px;
    padding: 10px 12px;
}

/* Spin box steppers ------------------------------------------------ */

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    background-color: transparent;
    border-left: 1px solid #232b36;
    border-top-right-radius: 5px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    background-color: transparent;
    border-left: 1px solid #232b36;
    border-bottom-right-radius: 5px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #21262d;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: @@ARROW_UP@@;
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: @@ARROW_DOWN@@;
    width: 8px;
    height: 5px;
}

/* ---------------------------------------------------------------------
   5. Check / radio / slider
   --------------------------------------------------------------------- */

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #e6edf3;
    padding: 2px 0px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #4d565f;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3d444d;
    background-color: #0a0e14;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #2dd4bf;
    background-color: rgba(45,212,191,0.12);
}

QCheckBox::indicator:checked {
    background-color: #2dd4bf;
    border-color: #2dd4bf;
    image: @@CHECK@@;
}

QRadioButton::indicator:checked {
    background-color: #0a0e14;
    border: 5px solid #2dd4bf;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #12171f;
    border-color: #232b36;
}

QCheckBox::indicator:checked:disabled {
    background-color: #1c2128;
    border-color: #3d444d;
}

QCheckBox#waitCloseCheckbox {
    spacing: 8px;
    color: #e6edf3;
}

QCheckBox#waitCloseCheckbox::indicator:checked {
    background-color: #f59e0b;
    border-color: #f59e0b;
    image: @@CHECK@@;
}

/* Slider ----------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #21262d;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #2dd4bf;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background-color: #21262d;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #e6edf3;
    border: 2px solid #2dd4bf;
    width: 12px;
    height: 12px;
    margin: -6px 0px;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #ffffff;
    border-color: #5eead4;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #21262d;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #e6edf3;
    border: 2px solid #2dd4bf;
    width: 12px;
    height: 12px;
    margin: 0px -6px;
    border-radius: 8px;
}

/* ---------------------------------------------------------------------
   6. Combo boxes and popups
   --------------------------------------------------------------------- */

QComboBox {
    background-color: #1c2128;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 30px 5px 10px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #3d444d;
    background-color: #21262d;
}

QComboBox:focus,
QComboBox:on {
    border-color: #2dd4bf;
}

QComboBox:disabled {
    background-color: #12171f;
    color: #4d565f;
    border-color: #232b36;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
    background-color: transparent;
}

/* @@CHEVRON@@ / @@CHEVRON_ACCENT@@ are replaced at load time by paths to
   small chevron PNGs painted by apply.py — Qt cannot rasterise a data URI. */
QComboBox::down-arrow {
    image: @@CHEVRON@@;
    width: 12px;
    height: 8px;
}

QComboBox::down-arrow:on,
QComboBox::down-arrow:hover {
    image: @@CHEVRON_ACCENT@@;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: rgba(45,212,191,0.18);
    selection-color: #e6edf3;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
    border-radius: 6px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(45,212,191,0.10);
}

QComboBox QAbstractItemView::item:selected {
    background-color: rgba(45,212,191,0.18);
    color: #e6edf3;
}

/* ---------------------------------------------------------------------
   7. Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: none;
    background-color: transparent;
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
    margin-right: 2px;
    min-height: 18px;
}

QTabBar::tab:hover {
    color: #e6edf3;
    background-color: rgba(45,212,191,0.06);
}

QTabBar::tab:selected {
    color: #5eead4;
    background-color: rgba(45,212,191,0.10);
    border-bottom: 2px solid #2dd4bf;
}

QTabBar::tab:disabled {
    color: #4d565f;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* Document-mode tab strips (AI turn card) sit on a card surface */
QTabWidget[documentMode="true"] QTabBar::tab,
QTabWidget::tab-bar QTabBar::tab {
    padding: 5px 10px;
}

QTabBar::close-button {
    subcontrol-position: right;
}

/* ---------------------------------------------------------------------
   8. Group boxes
   --------------------------------------------------------------------- */

/* Card-style group boxes: the title sits *inside* the frame, so the border
   stays continuous and never collides with the first form row. */
QGroupBox {
    background-color: #12171f;
    border: 1px solid #232b36;
    border-radius: 10px;
    margin-top: 0px;
    margin-bottom: 4px;
    padding: 34px 16px 16px 16px;
    font-size: 12px;
}

QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 14px;
    top: 11px;
    padding: 0px;
    background-color: transparent;
    color: #8b949e;
    font-size: 12px;
    font-weight: 600;
}

QGroupBox:disabled {
    border-color: #1a2029;
}

QGroupBox:disabled::title {
    color: #4d565f;
}

/* ---------------------------------------------------------------------
   9. Containers and cards
   --------------------------------------------------------------------- */

QFrame#aiTurnCard {
    background-color: #161b22;
    border: 1px solid #232b36;
    border-radius: 10px;
}

QFrame#reasoningFrame {
    background-color: #0a0e14;
    border: 1px solid #232b36;
    border-radius: 8px;
}

QFrame#conclusionBar {
    background-color: #1c2128;
    border: 1px solid #30363d;
    border-left: 3px solid #2dd4bf;
    border-radius: 8px;
    padding: 8px 12px;
}

QFrame#predictionGroup,
QFrame#cyclePredictionGroup {
    background-color: #161b22;
    border: 1px solid #232b36;
    border-radius: 10px;
}

QFrame#reasoningPane {
    background-color: #0a0e14;
    border: 1px solid #232b36;
    border-radius: 8px;
}

QWidget#chartPanel {
    background-color: #161b22;
    border: 1px solid #232b36;
    border-radius: 10px;
}

QWidget#summaryStrip {
    background-color: #12171f;
    border-bottom: 1px solid #232b36;
}

QWidget#flowBar {
    background-color: transparent;
}

/* The model pill inside styles its own QPushButton as a rounded chip; the
   wrapper only needs to stay transparent so it blends with the toolbar. */
QWidget#modelSelector {
    background-color: transparent;
}

QWidget#enhancedStatusBar {
    background-color: #12171f;
    border-top: 1px solid #232b36;
}

QStackedWidget {
    background-color: transparent;
}

QToolTip {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

/* ---------------------------------------------------------------------
   10. Item views (tables, trees, lists)
   --------------------------------------------------------------------- */

QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget {
    background-color: #0a0e14;
    alternate-background-color: #10151c;
    color: #e6edf3;
    border: 1px solid #232b36;
    border-radius: 8px;
    gridline-color: #1a2029;
    outline: 0;
    selection-background-color: rgba(45,212,191,0.18);
    selection-color: #e6edf3;
}

QTableView::item,
QTableWidget::item,
QTreeView::item,
QTreeWidget::item,
QListView::item,
QListWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableView::item:selected,
QTableWidget::item:selected,
QTreeView::item:selected,
QTreeWidget::item:selected,
QListView::item:selected,
QListWidget::item:selected {
    background-color: rgba(45,212,191,0.18);
    color: #e6edf3;
}

QTableView::item:hover,
QTableWidget::item:hover,
QTreeView::item:hover,
QTreeWidget::item:hover,
QListView::item:hover,
QListWidget::item:hover {
    background-color: rgba(45,212,191,0.08);
}

QHeaderView {
    background-color: #12171f;
    border: none;
}

QHeaderView::section {
    background-color: #12171f;
    color: #8b949e;
    border: none;
    border-right: 1px solid #232b36;
    border-bottom: 1px solid #232b36;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #1c2128;
    color: #e6edf3;
}

QHeaderView::section:checked {
    background-color: #1c2128;
    color: #5eead4;
}

QHeaderView::down-arrow,
QHeaderView::up-arrow {
    width: 10px;
    height: 10px;
}

QTableCornerButton::section {
    background-color: #12171f;
    border: none;
    border-right: 1px solid #232b36;
    border-bottom: 1px solid #232b36;
}

QTreeView::branch {
    background: transparent;
}

/* App-specific data views ------------------------------------------ */

QTreeWidget#decisionTreeView,
QTableWidget#pathReplayTable {
    background-color: #0a0e14;
    border: 1px solid #232b36;
    border-radius: 8px;
}

/* 下单参数条（控制栏下方的一条参数面板） ---------------------------- */

QFrame#orderParamsBar {
    background-color: #161b22;
    border: 1px solid #232b36;
    border-radius: 8px;
    padding: 2px;
}

QFrame#orderParamsBar QLabel {
    color: #8b949e;
    background: transparent;
    border: none;
}

QFrame#orderParamsBar QLabel#orderParamsTitle {
    color: #2dd4bf;
    font-weight: 600;
}

QFrame#orderParamsBar QDoubleSpinBox,
QFrame#orderParamsBar QSpinBox,
QFrame#orderParamsBar QComboBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 3px 6px;
    min-height: 20px;
}

QFrame#orderParamsBar QDoubleSpinBox:focus,
QFrame#orderParamsBar QSpinBox:focus,
QFrame#orderParamsBar QComboBox:focus,
QFrame#orderParamsBar QComboBox:on {
    border: 1px solid #2dd4bf;
}

QFrame#orderParamsBar QDoubleSpinBox:disabled,
QFrame#orderParamsBar QSpinBox:disabled,
QFrame#orderParamsBar QComboBox:disabled {
    background-color: #10151c;
    color: #4d5560;
    border: 1px solid #1c2128;
}

/* 历史下单表格 ------------------------------------------------------ */

QTableWidget#orderHistoryTable {
    background-color: #0a0e14;
    alternate-background-color: #0f141b;
    border: 1px solid #232b36;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: rgba(45,212,191,0.16);
    selection-color: #e6edf3;
}

QTableWidget#orderHistoryTable::item {
    padding: 4px 6px;
    border: none;
}

QTableWidget#orderHistoryTable::item:hover {
    background-color: rgba(45,212,191,0.07);
}

QTableWidget#orderHistoryTable::item:selected {
    background-color: rgba(45,212,191,0.18);
    color: #e6edf3;
}

QTableWidget#orderHistoryTable QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-right: 1px solid #1c2128;
    border-bottom: 1px solid #232b36;
    padding: 5px 6px;
    font-weight: 600;
}

/* 备用 AI 提供商表格：与历史下单表同款深色，单元格内嵌 QLineEdit 需要单独上色 */
QTableWidget#backupProvidersTable {
    background-color: #0a0e14;
    alternate-background-color: #0f141b;
    border: 1px solid #232b36;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: rgba(45,212,191,0.16);
    selection-color: #e6edf3;
}

QTableWidget#backupProvidersTable::item {
    padding: 3px 6px;
    border: none;
}

QTableWidget#backupProvidersTable::item:hover {
    background-color: rgba(45,212,191,0.07);
}

QTableWidget#backupProvidersTable::item:selected {
    background-color: rgba(45,212,191,0.18);
    color: #e6edf3;
}

QTableWidget#backupProvidersTable QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-right: 1px solid #1c2128;
    border-bottom: 1px solid #232b36;
    padding: 5px 6px;
    font-weight: 600;
}

QTableWidget#backupProvidersTable QLineEdit {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #21262d;
    border-radius: 4px;
    padding: 2px 6px;
    margin: 1px 2px;
}

QTableWidget#backupProvidersTable QLineEdit:focus {
    border: 1px solid #2dd4bf;
}

QTableWidget#backupProvidersTable QCheckBox {
    margin: 0px;
    padding: 0px;
}

/* Timeline (conversation history) ---------------------------------- */

QListWidget#timelineList {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 4px 2px;
}

QListWidget#timelineList::item {
    padding: 7px 8px;
    margin: 1px 0px;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 6px;
    color: #c9d1d9;
}

QListWidget#timelineList::item:hover {
    background-color: rgba(45,212,191,0.08);
    color: #e6edf3;
}

QListWidget#timelineList::item:selected {
    background-color: rgba(45,212,191,0.16);
    border-left: 2px solid #2dd4bf;
    color: #e6edf3;
}

/* Prompt file pickers ---------------------------------------------- */

QListWidget#promptFileList {
    background-color: #12171f;
    border: 1px solid #232b36;
    border-radius: 8px;
    padding: 4px;
}

QListWidget#promptFileList::item {
    padding: 6px 8px;
    border-radius: 6px;
    color: #c9d1d9;
}

QListWidget#promptFileList::item:hover {
    background-color: #1c2128;
    color: #e6edf3;
}

QListWidget#promptFileList::item:selected {
    background-color: rgba(45,212,191,0.16);
    color: #e6edf3;
}

/* ---------------------------------------------------------------------
   11. Scroll areas and scroll bars
   --------------------------------------------------------------------- */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollArea > QWidget > QScrollBar {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px 1px 2px 1px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    min-height: 28px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a5361;
}

QScrollBar::handle:vertical:pressed {
    background-color: #2dd4bf;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 1px 2px 1px 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    min-width: 28px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a5361;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #2dd4bf;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::corner {
    background: transparent;
    border: none;
}

/* ---------------------------------------------------------------------
   12. Splitter
   --------------------------------------------------------------------- */

QSplitter {
    background-color: transparent;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: rgba(45,212,191,0.24);
}

QSplitter::handle:pressed {
    background-color: rgba(45,212,191,0.40);
}

/* ---------------------------------------------------------------------
   13. Menu bar, menus, tool bar, status bar
   --------------------------------------------------------------------- */

QMenuBar {
    background-color: #0d1218;
    color: #c9d1d9;
    border-bottom: 1px solid #232b36;
    padding: 3px 6px;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    color: #c9d1d9;
    padding: 5px 10px;
    border-radius: 6px;
    margin: 0px 1px;
}

QMenuBar::item:selected {
    background-color: #21262d;
    color: #e6edf3;
}

QMenuBar::item:pressed {
    background-color: rgba(45,212,191,0.16);
    color: #e6edf3;
}

QMenu {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    color: #e6edf3;
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
    margin: 1px 0px;
}

QMenu::item:selected {
    background-color: rgba(45,212,191,0.16);
    color: #e6edf3;
}

QMenu::item:disabled {
    color: #4d565f;
}

QMenu::separator {
    height: 1px;
    background-color: #232b36;
    margin: 6px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

QToolBar {
    background-color: #0d1218;
    border: none;
    border-bottom: 1px solid #232b36;
    padding: 4px 6px;
    spacing: 6px;
}

QToolBar::separator {
    background-color: #232b36;
    width: 1px;
    margin: 4px 6px;
}

QStatusBar {
    background-color: #0d1218;
    color: #8b949e;
    border-top: 1px solid #232b36;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #8b949e;
    padding: 0px 6px;
}

/* ---------------------------------------------------------------------
   14. Progress bars
   --------------------------------------------------------------------- */

QProgressBar {
    background-color: #21262d;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #e6edf3;
    font-size: 10px;
    font-weight: 600;
}

/* Tinted chunks keep the centred percentage label legible on both the
   filled and the empty half of the bar. */
QProgressBar::chunk {
    background-color: rgba(56,189,248,0.65);
    border-radius: 4px;
}

QProgressBar[yellow="true"]::chunk {
    background-color: rgba(245,158,11,0.75);
}

QProgressBar[red="true"]::chunk {
    background-color: rgba(239,68,68,0.75);
}

QProgressBar#tokenProgress {
    background-color: #21262d;
    border: none;
    border-radius: 3px;
    color: #c9d1d9;
}

QProgressBar#tokenProgress::chunk {
    background-color: rgba(45,212,191,0.60);
    border-radius: 3px;
}

/* ---------------------------------------------------------------------
   15. Misc
   --------------------------------------------------------------------- */

QCheckBox#waitCloseCheckbox:checked {
    color: #fbbf24;
}
