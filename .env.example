# PA Agent 无头守护进程 —— 环境变量样例
#
# 复制成 .env 后填写：cp .env.example .env
# .env 里有明文密钥，务必 chmod 600 .env，且不要提交到 git。
#
# 优先级：环境变量 > config/settings.json > 内置默认值。
# 也就是说这里留空的项会回落到 settings.json，不会把它清掉。

# ─────────────────────────────────────────────────────────────────────────────
# 1. AI 模型（必需）
# ─────────────────────────────────────────────────────────────────────────────
# 当前配置：智谱 BigModel 的 glm-5 作为分析主模型。
#   Key 申请：https://open.bigmodel.cn
#   Base URL：https://open.bigmodel.cn/api/paas/v4
#
# 注意：bigmodel 的 max_tokens 上限是 131072，程序已按网关自动限流，
#       不要手动把 PA_AGENT_MODEL 换回 glm-4-flash —— 那个模型名会触发
#       精简契约（stage1 本地伪造、stage2 只解析 3 个字段），
#       导致 trade_confidence 恒为 50，自动下单必被拦。
PA_AGENT_API_KEY=
PA_AGENT_API_BASE=https://open.bigmodel.cn/api/paas/v4
PA_AGENT_MODEL=glm-5

# 其他可选服务商（改上三行即可）：
#   DeepSeek 官方   https://api.deepseek.com                  deepseek-chat
#   火山方舟        https://ark.cn-beijing.volces.com/api/v3  doubao-seed-2-1-lite-260915
#   超算互联网      https://api.scnet.cn/api/llm/v1           GLM-5.3-Flash
#  NVIDIA NIM     https://integrate.api.nvidia.com/v1        stepfun-ai/step-5-preview
#     └ 同一把 Key 下也有 z-ai/glm-5.3-flash、deepseek-ai/deepseek-v4.1-flash、
#       mistralai/mistral-large-4-1t-a52b。step-5-preview 最快（30 万字符 15.7s）。
#       该网关不认 thinking 字段，max_tokens 上限实测 65536，程序已按网关处理。

# ── 备用 GLM 通道（可选）─────────────────────────────────────────────────────
# 智谱 glm-4-flash，免费额度，用作最后的兜底。Key 申请：https://open.bigmodel.cn
#
# 生效条件（两个都要满足，缺一不会挂载）：
#   1) 主通道是「火山方舟」或「SenseNova 网关」
#   2) 这里填了 Key
# 若主通道是 DeepSeek 官方，这个 Key 会被忽略（官方通道本身不需要兜底）。
#
# 挂载后它排在 fallbacks 链的最末尾：方舟 12 个模型全试完才轮到它。
# 只填 PA_AGENT_GLM_API_KEY 这一行即可，模型名与 Base URL 已写死在代码里。
# PA_AGENT_GLM_API_KEY=
#   ↑ 也认 GLM_API_KEY / ZHIPU_API_KEY 这两个旧名，任填一个

# ── 备用链路池（可选，改了立即生效，不用重建镜像）──────────────────────────
#
# 写这一行就**整段替换** settings.json 里的备用池；不写则沿用 settings.json。
# 写法：条目之间用分号 ; 分隔，条目内字段用竖线 | 分隔，顺序即尝试顺序。
#
#     name|model|base_url|api_key
#
#   name      显示名，随便起；留空则用 model 当名字
#   model     模型名，必须是该网关认的名字
#   base_url  该网关的 OpenAI 兼容地址
#   api_key   写 - 表示复用上面 PA_AGENT_API_KEY 那把 Key（同网关多模型最省事）
#
# 例（三条都在同一把 NVIDIA Key 下，所以后两条写 -）：
#     PA_AGENT_FALLBACKS=GLM5.3|z-ai/glm-5.3-flash|https://integrate.api.nvidia.com/v1|-;DSv4|deepseek-ai/deepseek-v4.1-flash|https://integrate.api.nvidia.com/v1|-
#
# 当前默认（写在 settings.json 里，这里注释掉即可）：
#   1) 超算GLM      GLM-5.3-Flash                    https://api.scnet.cn/api/llm/v1
#   2) 超算互联网   DeepSeek-V4.1-Flash-1017-Event    https://api.scnet.cn/api/llm/v1
#   3) NVIDIA       stepfun-ai/step-5-preview        https://integrate.api.nvidia.com/v1
#
# 失效自动跳过：某条失败后进入 10 分钟冷却，冷却期内它被排到链尾而不是删除，
# 所以一条挂掉的通道不会在每个分析周期都重新撞一次，也不会让链路变空。
# PA_AGENT_FALLBACKS=

# ─────────────────────────────────────────────────────────────────────────────
# 2. 盯盘对象
# ─────────────────────────────────────────────────────────────────────────────
# binance 或 okx（只支持这两个）
PA_DAEMON_DATA_SOURCE=binance
PA_DAEMON_SYMBOL=BTCUSDT
# 1m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d 3d 1w 1M（OKX 不支持 3d / 8h）
PA_DAEMON_TIMEFRAME=15m
# 每次分析用多少根已收盘K线（越大越慢越贵，100 是默认均衡值）
PA_DAEMON_BAR_COUNT=100

# ─────────────────────────────────────────────────────────────────────────────
# 3. 节奏与成本
# ─────────────────────────────────────────────────────────────────────────────
# 多久拉一次行情（秒）。15m 周期 20 秒足够；不要小于 5 秒。
PA_DAEMON_POLL_INTERVAL=20
# 两次 AI 分析之间的最小间隔（秒）。15m 周期下 120 秒足够安全。
PA_DAEMON_ANALYSIS_COOLDOWN=120
# 只在K线收盘后分析（强烈建议 true，否则同一根K线会被反复分析）
PA_DAEMON_WAIT_BAR_CLOSE=true
# 启动时立刻分析一次（false = 等下一根K线收盘）
PA_DAEMON_ANALYZE_ON_START=false
# 整点重启时是否允许重复分析同一根K线（false = 跳过）
PA_DAEMON_SKIP_DUPLICATE=true
# 增量分析：把上一轮的决策带进本轮（省 token，也更连贯）
PA_DAEMON_INCREMENTAL=true
PA_DAEMON_INCREMENTAL_THRESHOLD=10

# ─────────────────────────────────────────────────────────────────────────────
# 4. 日志
# ─────────────────────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
PA_DAEMON_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# 5. 钉钉 / PushPlus（可选，也可以写在 config/settings.json 里）
# ─────────────────────────────────────────────────────────────────────────────
# 钉钉群机器人：安全设置选「加签」，把 Webhook 与密钥都填上
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# PushPlus（https://www.pushplus.plus/）
PUSHPLUS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 6. 交易所凭据（只有要真实下单时才需要）
# ─────────────────────────────────────────────────────────────────────────────
# 行情（K线）走公开接口，不填也能正常分析 —— 不填就只分析、不下单。
# 填了这些变量就不必再把明文 Key 写进 config/settings.json。
#
# Binance：API 管理里勾选「允许现货交易」；若做合约还要勾「允许合约交易」。
#   服务器要下单的话，记得把服务器公网 IP 填进 Key 的 IP 白名单。
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# 用测试网（下单不会动真钱）：true / false
# BINANCE_TESTNET=false
#
# OKX：API 管理里勾「交易」，权限选「交易」；同时要填 Passphrase。
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# 用模拟盘：true / false
# OKX_DEMO=false

# ─────────────────────────────────────────────────────────────────────────────
# 7. 自动交易开关（默认全关：只分析、不下单）
# ─────────────────────────────────────────────────────────────────────────────
# 总开关。true 才会真的进入下单流程（仍受下面的 dry_run 与各项闸门约束）。
# PA_DAEMON_AUTO_TRADE=false
# true = 只记录「本应下单」的意图，不真的发单。建议先跑一周。
# PA_DAEMON_DRY_RUN=true
# 在哪个交易所下单：binance / okx（可以与上面的行情来源不同）
#   例：行情用 binance，下单用 okx —— 一样支持。
# PA_DAEMON_VENUE=binance

# ── 下单参数（这几项决定「下多少钱」）───────────────────────────────────────
# 程序里没有「按账户余额百分比」模式，一律是**固定金额**，与余额无关。
# 具体下多少由 PA_DAEMON_MARGIN_MODE 二选一决定：
#
#   cross（全仓）     名义金额 = PA_DAEMON_MAX_NOTIONAL
#                     占用保证金 = 名义 ÷ 杠杆
#                     PA_DAEMON_MARGIN_PER_TRADE 完全不生效
#
#   isolated（逐仓）  名义金额 = PA_DAEMON_MARGIN_PER_TRADE × PA_DAEMON_LEVERAGE
#                     占用保证金 = PA_DAEMON_MARGIN_PER_TRADE
#                     PA_DAEMON_MAX_NOTIONAL 完全不生效
#
# PA_DAEMON_MARKET_TYPE —— spot（现货）/ futures（U 本位永续）
#   spot 时杠杆被强制成 1，保证金模式失效。
# PA_DAEMON_MARKET_TYPE=futures
#
# PA_DAEMON_MARGIN_MODE —— isolated（逐仓）/ cross（全仓），仅合约有效
# PA_DAEMON_MARGIN_MODE=isolated
#
# PA_DAEMON_LEVERAGE —— 1~125 整数，现货下被强制成 1。
#   只影响「占用保证金 = 名义 ÷ 杠杆」，不放大仓位大小。
# PA_DAEMON_LEVERAGE=10
#
# PA_DAEMON_MARGIN_PER_TRADE —— 每单保证金（USDT，正数）
#   只在 futures + isolated 下生效，决定名义金额与占用保证金。
#   例：10 U × 10x = 100 U 名义，占用保证金 10 U。
# PA_DAEMON_MARGIN_PER_TRADE=10
#
# PA_DAEMON_MAX_NOTIONAL —— 单笔名义金额（USDT，正数）
#   在「现货」与「合约 + 全仓」下生效，且**就是实际下单金额**（不是上限）。
#   例：20 U 全仓 10 倍 → 每单 20 U 名义，占用保证金 2 U。
# PA_DAEMON_MAX_NOTIONAL=20
#
# PA_DAEMON_ORDER_TYPE —— MARKET（市价）/ LIMIT（限价）
#   只是偏好；最终由 AI 决策里的 order_type 决定，决策说「不下单」就直接放弃。
# PA_DAEMON_ORDER_TYPE=LIMIT
#
# ⚠ 注意：最低置信度（min_confidence）、每日单数上限（max_daily_orders）、
#   强制止损（require_stop_loss）、品种白名单（allowed_symbols）、
#   跨所价差护栏（max_price_deviation_pct）**不提供环境变量通道**，
#   只能改 config/settings.json —— 避免一个 .env 拼写错误就把风控放宽了。

# ─────────────────────────────────────────────────────────────────────────────
# 8. 代理（可选，国内服务器访问 OKX / Binance 需要）
# ─────────────────────────────────────────────────────────────────────────────
# httpx 默认读这些变量，代码里不需要改任何东西。
#
# 代理跑在宿主机上（ShellCrash / Clash 装在服务器本机）→ 用 host.docker.internal：
#   容器里的 127.0.0.1 是容器自己，写它一定不通。
#   compose 里已默认带 extra_hosts: ["host.docker.internal:host-gateway"]。
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
#
# 代理跑在别的机器上（路由器 / NAS）→ 直接写它的内网 IP：
# HTTPS_PROXY=http://192.168.1.10:7890
# HTTP_PROXY=http://192.168.1.10:7890
#
# 让钉钉 / PushPlus / AI 走直连，避免绕远：
# NO_PROXY=oapi.dingtalk.com,www.pushplus.plus,api.deepseek.com,open.bigmodel.cn,api.scnet.cn
#
# ShellCrash 的 HTTP/SOCKS5 端口默认 7890（2-功能设置 → 7-进阶设置 → 1），
# 面板端口默认 9999；改过就以自己日志里的为准。
# 容器侧验证：docker exec pa-agent sh -c 'env | grep -i proxy'

# ─────────────────────────────────────────────────────────────────────────────
# 9. 容器用户（一般不用改）
# ─────────────────────────────────────────────────────────────────────────────
# 入口脚本以 root 修正挂载目录属主后，降权到这个 UID/GID 运行。
# 若宿主机上的目录属于别的用户（比如 1000），把这两个改成 1000 即可。
# PA_AGENT_UID=10001
# PA_AGENT_GID=10001
